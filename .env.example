# ============================================================
# APP
# ============================================================
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
BASE_URL=http://localhost:5000
PORT=5000

# ============================================================
# DATABASE
# Local dev: sqlite:///dev.db  OR  postgresql+psycopg2://user:pass@localhost:5432/ecom
# Production: MUST be PostgreSQL (Cloud SQL)
# ============================================================
DATABASE_URL=postgresql+psycopg2://ecom_user:ecom_password@localhost:5432/ecom_db

# Cloud SQL (Cloud Run only, used when INSTANCE_CONNECTION_NAME is set)
INSTANCE_CONNECTION_NAME=
DB_NAME=ecom_db
DB_USER=ecom_user
DB_PASSWORD=

# SQLAlchemy connection pool tuning (Cloud Run serverless friendly)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ============================================================
# RAZORPAY
# https://dashboard.razorpay.com/app/keys
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# ============================================================
# GOOGLE CLOUD
# ============================================================
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
GCS_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# "Sign in with Google" — leave both blank to hide the button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Authorized redirect URI:
#   http://localhost:5000/login/google/callback        (local, flask run)
#   http://localhost:8000/login/google/callback         (local, docker compose)
#   https://<your-domain>/login/google/callback          (production)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================================
# EMAIL (SMTP)
# ============================================================
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_ENABLED=false

# ============================================================
# SECURITY / MISC
# ============================================================
SESSION_COOKIE_SECURE=false
WTF_CSRF_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO

# ============================================================
# ADMIN SEED (used only by `flask seed-admin` when --password omitted)
# ============================================================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
