# ============================================================
# APP
# ============================================================
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
BASE_URL=http://localhost:5000
PORT=5000

# ============================================================
# DATABASE — Firestore in Datastore mode, via google-cloud-ndb
# Local dev: run the emulator and point the app at it:
#   gcloud beta emulators datastore start --consistency=1.0
# (docker compose does this for you). Production (Cloud Run) needs neither
# variable — it uses the project's real database.
# ============================================================
DATASTORE_EMULATOR_HOST=localhost:8081
DATASTORE_PROJECT_ID=e-com-local

# ============================================================
# RAZORPAY
# https://dashboard.razorpay.com/app/keys
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# ============================================================
# GOOGLE CLOUD
# ============================================================
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
GCS_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# "Sign in with Google" — leave both blank to hide the button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Authorized redirect URI:
#   http://localhost:5000/login/google/callback        (local, flask run)
#   http://localhost:8000/login/google/callback         (local, docker compose)
#   https://<your-domain>/login/google/callback          (production)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Trust X-Forwarded-Proto/Host from Cloud Run so OAuth callback URLs are https://.
# Defaults to true in production, false elsewhere.
TRUST_PROXY_HEADERS=

# ============================================================
# EMAIL (SMTP)
# ============================================================
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_ENABLED=false

# ============================================================
# SECURITY / MISC
# ============================================================
SESSION_COOKIE_SECURE=false
# Minutes a login stays valid after the last visit (survives closing the browser)
SESSION_LIFETIME_MINUTES=480
# Days "Remember me" keeps someone signed in
REMEMBER_COOKIE_DAYS=14
WTF_CSRF_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO

# ============================================================
# ADMIN SEED (used only by `flask seed-admin` when --password omitted)
# ============================================================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
